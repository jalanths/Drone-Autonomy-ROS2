<model name="iris_demo"><include><uri>model://iris_with_ardupilot</uri></include></model>
  
    <!-- ══════════════════════════════════════════════════════════════════
         ROS 2 state plugin — lets dynamic_obstacle_node.py move obstacles
         at runtime via /gazebo/set_entity_state. Gazebo Classic <actor>
         animations do NOT carry their collision geometry with them, so the
         LiDAR would never see an actor. Driving real models through this
         service keeps collisions (and therefore laser returns) correct.
         ══════════════════════════════════════════════════════════════════ -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <model name="dyn_block_0">
      <pose>20.0 0.0 4.0 0 0 0</pose>
      <link name="link">
        <!-- Gravity off: the node teleports these each tick, and a falling
             block would leave the drone's flight level immediately. -->
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial><mass>1.0</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>3 3 3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>3 3 3</size></box></geometry>
          <material>
            <ambient>0.9 0.25 0.15 1</ambient><diffuse>0.9 0.25 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dyn_block_1">
      <pose>20.0 56.0 4.0 0 0 0</pose>
      <link name="link">
        <!-- Gravity off: the node teleports these each tick, and a falling
             block would leave the drone's flight level immediately. -->
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial><mass>1.0</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>3 3 3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>3 3 3</size></box></geometry>
          <material>
            <ambient>0.9 0.55 0.10 1</ambient><diffuse>0.9 0.55 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dyn_block_2">
      <pose>-25.0 48.0 4.0 0 0 0</pose>
